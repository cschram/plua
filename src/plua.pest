Program = _{ SOI ~ (Line ~ EOL)* ~ (Line ~ EOI) }

Line = _{
    MetaInclude
  | MetaLine
  | LuaLine
}

// Meta includes:
// ```
// ##!include "myinclude"
// ```
MetaInclude = { MetaIncludePrefix ~ DoubleQuote ~ Filename ~ DoubleQuote ~ Whitespace* }

MetaIncludePrefix = _{ Whitespace* ~ "##!include" ~ Whitespace* }

DoubleQuote = _{ "\"" }

Filename = { (!DoubleQuote ~ Character)+ }

// Single-line preprocessor line:
// ```
// ## local foo = "bar"
// ```
MetaLine = { MetaLinePrefix ~ MetaLineContent }

MetaLinePrefix = _{ Whitespace* ~ "##" }

MetaLineContent = { Character* }

// Preprocessor value interpolation
// ```
// print(#[foo]#)
// ```
MetaValueInterpolate = { MetaValueInterpolatePrefix ~ Lua ~ MetaValueInterpolateSuffix }

MetaValueInterpolatePrefix = _{ "#[" }

MetaValueInterpolateSuffix = _{ "]#" }

// Preprocessor code interpolation
// ```
// ## function increment(ident, inc)
//   #{ident}# = #{ident}# + #[inc]#
// ## end
MetaCodeInterpolate = { MetaCodeInterpolatePrefix ~ Lua ~ MetaCodeInterpolateSuffix }

MetaCodeInterpolatePrefix = _{ "#{" }

MetaCodeInterpolateSuffix = _{ "}#" }

// Any lua code
LuaLine = { (MetaValueInterpolate | MetaCodeInterpolate | Lua)* }

Lua = { (!(MetaValueInterpolatePrefix | MetaValueInterpolateSuffix | MetaCodeInterpolatePrefix | MetaCodeInterpolateSuffix) ~ Character)+ }

// Common rules
EOL = _{ "\n" | "\r\n" }

Whitespace = _{ " " | "\t" }

Character = _{ !EOL ~ ANY }
