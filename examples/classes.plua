##function class(name)
  local #|name|# = {}
  function #|name|#:new(...)
    local obj = {}
    setmetatable(obj, self)
    self.__index = self
    obj:init(...)
    return obj
  end
##end

##class("Person")

function Person:init(name, age)
  self.name = name
  self.age = age
end

function Person:greet()
  print("Hello, I am " .. self.name .. ", and I am " .. self.age .. " years old.")
end

local p = Person:new("Corey", 33)
p:greet()
