##[[
function create_logger(prefix)
    Plua.emit(#{
        function(msg)
            log("}# .. prefix .. #{: " .. msg)
        end
    }#)
end
]]

local log_pow = #|create_logger("pow")|#

print(log_pow(#[pow(4, 2)]#))

